---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "RALUM S.A. | Venta y Fabricación de Radiadores Automotrices e Industriales",
  description = "Especialistas en radiadores automotrices, carga pesada y maquinaria. Búsqueda por vehículo, medidas de núcleo y número de parte.",
  image = "/logo.jpg" // Imagen por defecto de tu negocio
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://ralum-s-a.ariashdez.workers.dev');
const ogImageURL = new URL(image, Astro.site || 'https://ralum-s-a.ariashdez.workers.dev');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Metadatos Primarios -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="RALUM S.A." />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen">
    <slot />
  </body>
</html>