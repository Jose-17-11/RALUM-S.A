---
import { FaPhoneAlt, FaEnvelope, FaMapMarkerAlt } from 'react-icons/fa';
---
<footer class="bg-brand-navy text-white border-t-4 border-theme-red mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 md:grid-cols-4 gap-8">
    <div class="space-y-3">
      <div class="flex items-center gap-2">
        <div class="bg-theme-red p-2 rounded text-white font-black text-lg">R</div>
        <span class="text-xl font-black italic">RALUM <span class="text-theme-red">S.A.</span></span>
      </div>
      <p class="text-xs text-slate-400 leading-relaxed">
        Especialistas en la distribución de radiadores automotrices, radiadores 100% de aluminio, aires acondicionados automotrices y fabricamos tanques de aluminio para radiador.
      </p>
    </div>

    <div>
      <h4 class="text-sm font-bold uppercase tracking-wider text-slate-200 mb-3 border-b border-slate-700 pb-1">Navegación</h4>
      <ul class="space-y-2 text-xs text-slate-400">
        <li><a href="#inicio" class="hover:text-white transition">Inicio</a></li>
        <li><a href="#buscador" class="hover:text-white transition">Buscador de Autopartes</a></li>
        <li><a href="#contacto" class="hover:text-white transition">Atención a Refaccionarias</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-bold uppercase tracking-wider text-slate-200 mb-3 border-b border-slate-700 pb-1">Servicios</h4>
      <ul class="space-y-2 text-xs text-slate-400">
        <li class="flex items-center gap-1.5"><span class="text-theme-red">✓</span> Venta de Radiadores de Línea</li>
        <li class="flex items-center gap-1.5"><span class="text-theme-red">✓</span> Fabricación y Trabajos Especiales</li>
        <li class="flex items-center gap-1.5"><span class="text-theme-red">✓</span> Adaptaciones y Modificaciones</li>
        <li class="flex items-center gap-1.5"><span class="text-theme-red">✓</span> Asesoría Técnica Especializada</li>
      </ul>
    </div>

    <div id="contacto">
    <h4 class="text-sm font-bold uppercase tracking-wider text-slate-200 mb-3 border-b border-slate-700 pb-1">
      Contacto Directo
    </h4>
    <div class="space-y-2.5 text-xs text-slate-400">
      <!-- Correo Electrónico -->
      <p class="flex items-center gap-2">
        <FaEnvelope className="w-3.5 h-3.5 text-theme-red shrink-0" />
        <a href="mailto:contacto@ralumsa.com.mx" class="hover:text-white transition">
          contacto@ralumsa.com.mx
        </a>
      </p>

      <!-- Teléfonos de Atención -->
      <div class="flex items-start gap-2">
        <FaPhoneAlt className="w-3.5 h-3.5 text-theme-red shrink-0 mt-0.5" />
        <div class="flex flex-col gap-0.5">
          <a href="tel:7353980048" class="hover:text-white transition font-medium">
            735 398 0048
          </a>
          <a href="tel:7353532248" class="hover:text-white transition font-medium">
            735 353 2248
          </a>
        </div>
      </div>

      <!-- Ubicación -->
      <p class="flex items-center gap-2">
        <FaMapMarkerAlt className="w-3.5 h-3.5 text-theme-red shrink-0" />
        <span>Cuautla, Morelos, México</span>
      </p>
    </div>
  </div>
  </div>

  <div class="bg-brand-dark py-4 text-center text-xs text-slate-500 border-t border-slate-800">
    © {new Date().getFullYear()} RALUM S.A. Todos los derechos reservados.
  </div>
</footer>