---
---
<section id="contacto" class="py-16 bg-brand-gray-bg border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-block px-3 py-1 bg-theme-red/10 border border-theme-red/30 rounded-full text-theme-red text-xs font-bold uppercase tracking-wider mb-2">
        Contacto Directo
      </div>
      <h2 class="text-3xl font-black text-brand-navy uppercase tracking-tight">
        ¿Requieres una Cotización Especial o Mayoreo?
      </h2>
      <p class="text-slate-600 text-sm mt-2">
        Déjanos tus datos o escríbenos directamente por WhatsApp para recibir atención inmediata de nuestro equipo técnico.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Información de Contacto Directo -->
      <div class="lg:col-span-5 bg-brand-navy text-white rounded-2xl p-6 sm:p-8 space-y-6 shadow-xl">
        <h3 class="text-xl font-bold border-b border-slate-700 pb-3">Información de Atención</h3>

        <div class="space-y-4 text-sm">
          <div class="flex items-start gap-4">
            <div class="bg-theme-red p-2.5 rounded-lg text-white font-bold text-base">📱</div>
            <div>
              <span class="block text-xs text-slate-400 font-semibold uppercase">WhatsApp / Teléfono</span>
              <a href="https://wa.me/527351948537" target="_blank" class="font-bold text-white hover:text-theme-red transition text-base">
                +52 735 194 8537
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="bg-theme-red p-2.5 rounded-lg text-white font-bold text-base">✉️</div>
            <div>
              <span class="block text-xs text-slate-400 font-semibold uppercase">Correo Electrónico</span>
              <span class="font-semibold text-slate-200">contacto@ralumsa.com.mx</span>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="bg-theme-red p-2.5 rounded-lg text-white font-bold text-base">📦</div>
            <div>
              <span class="block text-xs text-slate-400 font-semibold uppercase">Envíos y Logística</span>
              <span class="font-semibold text-slate-200">Envíos express a todo México para refaccionarias y talleres.</span>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-700">
          <a
            href="https://wa.me/527351948537?text=Hola%20RALUM%20S.A.,%20quisiera%20solicitar%20información%20sobre%20ventas%20al%20mayoreo"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-4 rounded-xl text-xs uppercase tracking-wider text-center transition flex items-center justify-center gap-2"
          >
            💬 Abrir Chat Directo en WhatsApp
          </a>
        </div>
      </div>

      <!-- Formulario de Contacto -->
      <div class="lg:col-span-7 bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-xl">
        <form class="space-y-4" onsubmit="event.preventDefault(); alert('Mensaje enviado correctamente. Nos pondremos en contacto contigo.');">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Nombre Completo *</label>
              <input 
                type="text" 
                required 
                placeholder="Ej. Juan Pérez" 
                class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm font-semibold text-slate-800 focus:ring-2 focus:ring-brand-navy focus:outline-none" 
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Teléfono / WhatsApp *</label>
              <input 
                type="tel" 
                required 
                placeholder="Ej. 7351234567" 
                class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm font-semibold text-slate-800 focus:ring-2 focus:ring-brand-navy focus:outline-none" 
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Correo Electrónico</label>
              <input 
                type="email" 
                placeholder="correo@ejemplo.com" 
                class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm font-semibold text-slate-800 focus:ring-2 focus:ring-brand-navy focus:outline-none" 
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Tipo de Cliente</label>
              <select class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm font-semibold text-slate-800 focus:ring-2 focus:ring-brand-navy focus:outline-none">
                <option value="refaccionaria">Refaccionaria / Mayorista</option>
                <option value="taller">Taller Mecánico</option>
                <option value="particular">Particular / Cliente Final</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Mensaje o Detalle del Radiador *</label>
            <textarea 
              rows="4" 
              required 
              placeholder="Indícanos el modelo del vehículo, año o número de parte que necesitas..." 
              class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm font-semibold text-slate-800 focus:ring-2 focus:ring-brand-navy focus:outline-none"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full bg-theme-red hover:bg-theme-red-hover text-white font-bold py-3.5 px-6 rounded-xl text-sm transition uppercase tracking-wider shadow-lg shadow-theme-red/20"
          >
            Enviar Solicitud
          </button>
        </form>
      </div>

    </div>
  </div>
</section>