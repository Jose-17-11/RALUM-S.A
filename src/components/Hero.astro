---

<section id="inicio" class="relative bg-slate-950 text-white border-b-4 border-theme-red overflow-hidden select-none">
  <!-- Contenedor del Carrusel -->
  <div id="hero-carousel" class="relative w-full overflow-hidden">
    
    <!-- TRACK DE SLIDES -->
    <div id="carousel-track" class="flex w-full transition-transform duration-700 ease-out">
      
      <!-- SLIDE 1: Informativo Principal -->
      <div class="w-full basis-full shrink-0 relative bg-linear-to-br from-brand-navy via-slate-900 to-brand-navy py-10 sm:py-16 px-4 sm:px-6 lg:px-8 flex items-center min-h-115 sm:min-h-130">
        <div class="max-w-6xl mx-auto w-full grid md:grid-cols-12 gap-6 sm:gap-8 items-center">
          
          <!-- Texto Principal -->
          <div class="md:col-span-7 space-y-3.5 sm:space-y-4 text-center md:text-left">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-theme-red/15 border border-theme-red/30 rounded-full text-theme-red text-[11px] sm:text-xs font-bold uppercase tracking-wider">
              <span>✓</span> Especialistas en Enfriamiento Automotriz
            </div>
            
            <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-white leading-tight tracking-tight">
              Radiadores de Línea y <span class="text-theme-red underline decoration-theme-red/40">Fabricación a Medida</span>
            </h1>
            
            <p class="text-slate-300 text-xs sm:text-sm md:text-base max-w-xl mx-auto md:mx-0 leading-relaxed">
              Venta para autos, camionetas, carga pesada y maquinaria. Localiza la pieza exacta por vehículo, medidas de núcleo o número de parte.
            </p>
            
            <div class="pt-2 flex flex-wrap gap-2.5 sm:gap-3 justify-center md:justify-start">
              <a href="#buscador" class="bg-theme-red hover:bg-theme-red-hover text-white px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl font-bold text-xs sm:text-sm shadow-lg shadow-theme-red/30 transition transform hover:-translate-y-0.5">
                Ir al Buscador
              </a>
              <a href="#contacto" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl font-bold text-xs sm:text-sm border border-slate-700 transition">
                Atención en Mostrador
              </a>
            </div>
          </div>

          <!-- Badges de Métricas -->
          <div class="md:col-span-5 grid grid-cols-2 gap-2 sm:gap-3">
            <div class="bg-slate-800/60 border border-slate-700/70 p-3 sm:p-4 rounded-xl text-center backdrop-blur-sm">
              <span class="block text-xl sm:text-3xl font-black text-theme-red mb-0.5">+15</span>
              <span class="text-[10px] sm:text-xs text-slate-300 font-semibold">Años de Trayectoria</span>
            </div>
            <div class="bg-slate-800/60 border border-slate-700/70 p-3 sm:p-4 rounded-xl text-center backdrop-blur-sm">
              <span class="block text-xl sm:text-3xl font-black text-white mb-0.5">100%</span>
              <span class="text-[10px] sm:text-xs text-slate-300 font-semibold">Garantía en Ajuste</span>
            </div>
            <div class="bg-slate-800/60 border border-slate-700/70 p-3 sm:p-4 rounded-xl text-center backdrop-blur-sm">
              <span class="block text-base sm:text-2xl font-black text-white mb-0.5">Multimarca</span>
              <span class="text-[10px] sm:text-xs text-slate-300 font-semibold">Nacional e Importado</span>
            </div>
            <div class="bg-slate-800/60 border border-slate-700/70 p-3 sm:p-4 rounded-xl text-center backdrop-blur-sm">
              <span class="block text-base sm:text-2xl font-black text-theme-red mb-0.5">A Medida</span>
              <span class="text-[10px] sm:text-xs text-slate-300 font-semibold">Trabajos Especiales</span>
            </div>
          </div>

        </div>
      </div>

      <!-- SLIDE 2: Fotografía de Taller / Fabricación Especial -->
      <div class="w-full basis-full shrink-0 relative py-12 sm:py-16 px-4 sm:px-6 lg:px-8 flex items-end sm:items-center justify-start min-h-115 sm:min-h-130">
        <!-- Imagen de Fondo -->
        <img 
          src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1600&q=80" 
          alt="Taller de radiadores y soldadura RALUM S.A." 
          class="absolute inset-0 w-full h-full object-cover object-center"
        />
        <!-- Overlay Gradiente -->
        <div class="absolute inset-0 bg-linear-to-t from-slate-950 via-slate-950/70 to-transparent sm:bg-linear-to-r sm:from-slate-950/90 sm:via-slate-950/60 sm:to-transparent"></div>

        <!-- Tarjeta de Contenido Flotante -->
        <div class="relative max-w-lg z-10 p-4 sm:p-6 mb-6 sm:mb-0 ml-0 sm:ml-8 bg-slate-900/85 backdrop-blur-md rounded-2xl border border-slate-700/60 space-y-2.5 sm:space-y-3">
          <span class="inline-block px-2.5 py-0.5 bg-amber-500/20 text-amber-400 border border-amber-500/30 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider">
            🛠️ Taller y Modificaciones
          </span>
          <h2 class="text-lg sm:text-3xl font-black text-white leading-tight">
            Fabricación y Adaptación de Paneles a la Medida
          </h2>
          <p class="text-xs sm:text-sm text-slate-300">
            Soluciones para equipo pesado, maquinaria industrial y modelos fuera de catálogo con aluminio soldado de alta durabilidad.
          </p>
          <div class="pt-1">
            <a 
              href="https://wa.me/527351948537?text=Hola%20RALUM%20S.A.,%20me%20interesa%20un%20trabajo%20a%20la%20medida" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-block bg-theme-red hover:bg-theme-red-hover text-white text-xs font-bold px-4 py-2.5 rounded-lg shadow transition"
            >
              Cotizar con Muestra Física
            </a>
          </div>
        </div>
      </div>

      <!-- SLIDE 3: Fotografía de Variedad / Inventario Mostrador -->
      <div class="w-full basis-full shrink-0 relative py-12 sm:py-16 px-4 sm:px-6 lg:px-8 flex items-end sm:items-center justify-start min-h-115 sm:min-h-130">
        <!-- Imagen de Fondo -->
        <img 
          src="https://images.unsplash.com/photo-1486262715619-67b85e0b08d3?auto=format&fit=crop&w=1600&q=80" 
          alt="Refacciones e inventario multimarca RALUM S.A." 
          class="absolute inset-0 w-full h-full object-cover object-center"
        />
        <!-- Overlay Gradiente -->
        <div class="absolute inset-0 bg-linear-to-t from-slate-950 via-slate-950/70 to-transparent sm:bg-linear-to-r sm:from-slate-950/90 sm:via-slate-950/60 sm:to-transparent"></div>

        <!-- Tarjeta de Contenido Flotante -->
        <div class="relative max-w-lg z-10 p-4 sm:p-6 mb-6 sm:mb-0 ml-0 sm:ml-8 bg-slate-900/85 backdrop-blur-md rounded-2xl border border-slate-700/60 space-y-2.5 sm:space-y-3">
          <span class="inline-block px-2.5 py-0.5 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider">
            📦 Atención Inmediata
          </span>
          <h2 class="text-lg sm:text-3xl font-black text-white leading-tight">
            Amplio Surtido para Todas las Marcas
          </h2>
          <p class="text-xs sm:text-sm text-slate-300">
            Encuentra radiadores nuevos y garantizados para las principales líneas automotrices comerciales del mercado.
          </p>
          <div class="pt-1">
            <a 
              href="#buscador" 
              class="inline-block bg-theme-red hover:bg-theme-red-hover text-white text-xs font-bold px-4 py-2.5 rounded-lg shadow transition"
            >
              Ver Catálogo por Vehículo
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- BOTONES PREV / NEXT (Visibles y adaptados para móvil y escritorio) -->
    <button 
      id="prev-btn" 
      aria-label="Slide anterior"
      class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-20 bg-slate-900/70 sm:bg-slate-900/80 hover:bg-theme-red text-white p-2 sm:p-3 rounded-full border border-slate-700/60 shadow-lg backdrop-blur-sm transition-all duration-200 active:scale-95 sm:hover:scale-105 focus:outline-none flex items-center justify-center"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <button 
      id="next-btn" 
      aria-label="Slide siguiente"
      class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-20 bg-slate-900/70 sm:bg-slate-900/80 hover:bg-theme-red text-white p-2 sm:p-3 rounded-full border border-slate-700/60 shadow-lg backdrop-blur-sm transition-all duration-200 active:scale-95 sm:hover:scale-105 focus:outline-none flex items-center justify-center"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- INDICADORES (DOTS) -->
    <div class="absolute bottom-3 sm:bottom-4 left-1/2 -translate-x-1/2 z-20 flex gap-2">
      <button class="carousel-dot w-6 h-2 rounded-full bg-theme-red transition-all duration-300" data-slide="0" aria-label="Ir a Slide 1"></button>
      <button class="carousel-dot w-2 h-2 rounded-full bg-slate-600 hover:bg-slate-400 transition-all duration-300" data-slide="1" aria-label="Ir a Slide 2"></button>
      <button class="carousel-dot w-2 h-2 rounded-full bg-slate-600 hover:bg-slate-400 transition-all duration-300" data-slide="2" aria-label="Ir a Slide 3"></button>
    </div>
  </div>
</section>

<script>
  function setupCarousel() {
    const track = document.getElementById('carousel-track');
    const dots = document.querySelectorAll('.carousel-dot');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const carousel = document.getElementById('hero-carousel');

    if (!track || dots.length === 0) return;

    let currentIndex = 0;
    const totalSlides = dots.length;
    let autoplayInterval: any = null;

    const updateCarousel = (index: number) => {
      currentIndex = index;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      // Actualizar estilo de dots activos
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.add('bg-theme-red', 'w-6');
          dot.classList.remove('bg-slate-600', 'w-2');
        } else {
          dot.classList.remove('bg-theme-red', 'w-6');
          dot.classList.add('bg-slate-600', 'w-2');
        }
      });
    };

    const nextSlide = () => {
      const nextIndex = (currentIndex + 1) % totalSlides;
      updateCarousel(nextIndex);
    };

    const prevSlide = () => {
      const prevIndex = (currentIndex - 1 + totalSlides) % totalSlides;
      updateCarousel(prevIndex);
    };

    nextBtn?.addEventListener('click', () => {
      nextSlide();
      resetAutoplay();
    });

    prevBtn?.addEventListener('click', () => {
      prevSlide();
      resetAutoplay();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const targetIndex = Number(target.dataset.slide);
        updateCarousel(targetIndex);
        resetAutoplay();
      });
    });

    // Soporte para Touch Swipe en móviles
    let touchStartX = 0;
    let touchEndX = 0;

    carousel?.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoplay();
    }, { passive: true });

    carousel?.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
      startAutoplay();
    }, { passive: true });

    const handleSwipe = () => {
      const swipeDistance = touchEndX - touchStartX;
      if (Math.abs(swipeDistance) > 45) {
        if (swipeDistance < 0) {
          nextSlide();
        } else {
          prevSlide();
        }
      }
    };

    const startAutoplay = () => {
      if (!autoplayInterval) {
        autoplayInterval = setInterval(nextSlide, 5000);
      }
    };

    const stopAutoplay = () => {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
        autoplayInterval = null;
      }
    };

    const resetAutoplay = () => {
      stopAutoplay();
      startAutoplay();
    };

    carousel?.addEventListener('mouseenter', stopAutoplay);
    carousel?.addEventListener('mouseleave', startAutoplay);

    startAutoplay();
  }

  document.addEventListener('DOMContentLoaded', setupCarousel);
  document.addEventListener('astro:page-load', setupCarousel);
</script>