---
import Layout from '../layouts/Layout.astro';
import CatalogSearch from '../components/CatalogSearch.jsx';
import { getProducts } from '../data/api.js';

export async function getStaticPaths() {
  const products = await getProducts();

  // Filtrar que exista un código DPI válido para generar la ruta estática
  const validProducts = products.filter(
    (product) => product && typeof product.iss === 'string' && product.iss.trim().length > 0
  );

  return validProducts.map((product) => ({
    params: { sku: product.iss.trim() },
    props: { product, allProducts: validProducts },
  }));
}

const { product, allProducts } = Astro.props;

const mainBrand = product.brands?.[0] || 'Multimarca';
const mainModel = product.models?.[0] || '';
const pageTitle = `${product.title} (ISS: ${product.iss}) | RALUM S.A.`;
const pageDescription = `Radiador automotriz para ${mainBrand} ${mainModel} (${product.transmission}). Medidas: ${product.measures}. Clave ISS: ${product.iss}. ¡Cotiza directo en RALUM S.A.!`;
const pageImage = product.images?.[0] || 'https://images.unsplash.com/photo-1486262715619-67b85e0b08d3?auto=format&fit=crop&w=800&q=80';
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
>
  <main class="max-w-7xl mx-auto px-4 py-8">
    <CatalogSearch client:load initialProducts={allProducts} />
  </main>
</Layout>