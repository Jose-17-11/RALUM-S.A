---
import Layout from '../layouts/Layout.astro';
import CatalogSearch from '../components/CatalogSearch.jsx';
import { getProducts } from '../data/api.js';

export async function getStaticPaths() {
  const products = await getProducts();

  return products.map((product) => ({
    params: { sku: product.sku },
    props: { product, allProducts: products },
  }));
}

const { product, allProducts } = Astro.props;

// Metadatos optimizados para SEO y Open Graph
const pageTitle = `${product.title} (OEM: ${product.oem}) | RALUM S.A.`;
const pageDescription = `Radiador para ${product.brand} ${product.model} (${product.transmission}). Medidas: ${product.measures}. Clave: ${product.sku}. ¡Cotiza directo en RALUM S.A.!`;
const pageImage = product.images?.[0] || 'https://images.unsplash.com/photo-1486262715619-67b85e0b08d3?auto=format&fit=crop&w=800&q=80';
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
>
  <main class="max-w-7xl mx-auto px-4 py-8">
    <CatalogSearch client:load initialProducts={allProducts} />
  </main>
</Layout>