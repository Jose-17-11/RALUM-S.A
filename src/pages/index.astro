---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import QuickSearchBar from '../components/QuickSearchBar.jsx';
import Hero from '../components/Hero.astro';
import CatalogSearch from '../components/CatalogSearch.jsx';
import Servicios from '../components/Services.astro';
import Nosotros from '../components/About.astro';
import Contacto from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { getProducts } from '../data/api.js';

// 1. Obtener la data del webhook de n8n
const products = await getProducts();
console.log('Total productos recibidos de n8n en el build:', products.length);
---

<Layout title="RALUM S.A. | Radiadores Automotrices e Industriales">
  <Header />

  <!-- 2. Pasar 'products' como prop -->
  <QuickSearchBar client:load initialProducts={products} />

  <Hero />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    <!-- 3. Pasar 'products' como prop -->
    <CatalogSearch client:load initialProducts={products} />
    <Servicios />
    <Nosotros />
    <Contacto />
  </main>

  <Footer />
</Layout>