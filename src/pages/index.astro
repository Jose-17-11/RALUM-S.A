---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="RALUM S.A. | Catálogo Digital & Búsqueda de Autopartes">
  <Header />
  <Hero />
  <main id="buscador" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grow w-full">
    <div class="text-center mb-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy uppercase tracking-tight">
        Catálogo Digital de Autopartes
      </h2>
      <p class="text-slate-600 text-sm mt-1">
        Filtros avanzados estilo Spectra Premium para localizar la pieza correspondiente.
      </p>
    </div>

    <!-- Isla de React para la búsqueda dinámica -->
    <!-- <CatalogSearch client:load /> -->
  </main>
  <Footer />
</Layout>